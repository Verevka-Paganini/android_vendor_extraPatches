From 5082a1bac2c49c0679dd44ba5d22e918da560b41 Mon Sep 17 00:00:00 2001
From: Giovanni Ricca <giovanniricca@proton.me>
Date: Thu, 26 Feb 2026 20:52:40 +0100
Subject: [PATCH 1/3] hal: Define `udfps` soong variable

Change-Id: Iebdb0babe5a368e7417cda33b889d0bc826220d5
---
 Android.bp                | 4 ++++
 config/display-product.mk | 2 ++
 2 files changed, 6 insertions(+)

diff --git a/Android.bp b/Android.bp
index 8ba1c9a10..c552f4873 100644
--- a/Android.bp
+++ b/Android.bp
@@ -7,6 +7,7 @@ soong_config_module_type {
         "headless",
         "llvmsa",
         "gralloc4",
+        "udfps",
         "default",
         "var3",
         "llvmcov",
@@ -150,6 +151,9 @@ qtidisplay_cc_defaults {
         neo: {
             cflags: ["-DTARGET_INCLUDES_NEO"],
         },
+        udfps: {
+            cflags: ["-DUDFPS_ZPOS"],
+        },
         var3 : {
             enabled: false,
             conditions_default: {
diff --git a/config/display-product.mk b/config/display-product.mk
index 6ae855874..95f26a0b0 100644
--- a/config/display-product.mk
+++ b/config/display-product.mk
@@ -169,6 +169,7 @@ SOONG_CONFIG_qtidisplay := drmpp headless llvmsa \
                            composer_version smmu_proxy \
                            ubwcp_headers hwasan mapper_ext \
                            neo
+SOONG_CONFIG_qtidisplay += udfps
 
 # Soong Values
 SOONG_CONFIG_qtidisplay_neo := false
@@ -187,6 +188,7 @@ SOONG_CONFIG_qtidisplay_smmu_proxy := false
 SOONG_CONFIG_qtidisplay_ubwcp_headers := true
 SOONG_CONFIG_qtidisplay_composer_version := v3
 SOONG_CONFIG_qtidisplay_mapper_ext := true
+SOONG_CONFIG_qtidisplay_udfps := false
 
 ifeq ($(PLATFORM_VERSION), 14)
     SOONG_CONFIG_qtidisplay_mapper_ext := false
